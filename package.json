{
  "name": "portal-resultados-ci",
  "version": "1.1.0",
  "scripts": {
    "validate:data": "node src/validateCandidates.js data/candidatos.json",
    "test": "node test/validateCandidates.test.js",
    "check:version": "node scripts/checkVersionSync.js",
    "build": "node src/buildReport.js",
    "manifest": "node scripts/writeManifest.js",
    "gate": "node scripts/qualityGate.js dist/relatorio.json",
    "ci": "npm run validate:data && npm test && npm run check:version && npm run build"
  }
}